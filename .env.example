# AI アシスタント（行きたいスポット候補チャット）用の環境変数。
# このファイルを .env にコピーして値を設定してください（.env は Git 管理外）。

# ============================================================
#  認証（Google SSO）とユーザーごと storage 分離
# ============================================================

# 認証セッション（JWT Cookie）の署名鍵（必須）。十分に長いランダム文字列を設定する。
#   例: openssl rand -hex 32
SESSION_SECRET=

# Google OAuth 2.0 / OIDC クライアント（Web）の資格情報。
# GCP コンソール「API とサービス → 認証情報」で OAuth クライアント（Web）を作成し、
# 承認済みリダイレクト URI に <origin>/auth/google を登録する。
#   ローカル: http://localhost:5173/auth/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ログインは許可制。新規ユーザーは users に allowed=false（承認待ち）で登録され、
# 承認（allowed=true）されるまでアプリを使えない。承認は管理ダッシュボード
# （/admin・下記の ADMIN_* を参照）から行う。承認済みユーザーの中で、どのプロジェクトを
# 見られるかはプロジェクトメンバーシップ（メール招待・projects.memberEmails）で担う。
# メタ情報（users / projects）は Firestore で管理する。
#   FIRESTORE_PROJECT_ID  … Firestore のプロジェクト ID（本番は Cloud Run が自動解決）
#   FIRESTORE_DATABASE_ID … データベース ID（既定 "(default)"）
#   FIRESTORE_USERS_COLLECTION / FIRESTORE_PROJECTS_COLLECTION … 既定 users / projects
# FIRESTORE_PROJECT_ID=your-gcp-project-id
# FIRESTORE_DATABASE_ID=(default)
#
# ローカルで実際の Google ログインを試す場合の Firestore 認証は次のいずれか:
#   - GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json（SA 鍵）
#   - FIRESTORE_EMULATOR_HOST=localhost:8085（Firestore エミュレータ）
# ※ 下の DEV_LOGIN バイパスでも Firestore は使う（projects 作成/参照のため）。

# ============================================================
#  管理ダッシュボード（利用承認・#103）
# ============================================================
# /admin でユーザー一覧と利用承認（allowed）・ロール変更を行う。
# アクセス制御は二段構え:
#   1. Basic 認証 … /admin 配下（画面 + API）に適用。下の 2 つが両方設定されている
#      ときだけ有効になり、未設定なら /admin は 503 で閉じる（フェイルクローズ）。
#   2. Google SSO の role=admin … /admin/api/* に適用（非 admin は 403）。
ADMIN_BASIC_USER=
ADMIN_BASIC_PASS=

# 初期管理者のメール（カンマ区切り・任意）。ここに挙げたメールはログイン時に
# allowed=true / role=admin へ自動昇格する。最初の 1 人を作るための設定で、
# 以降のロール変更は管理ダッシュボードから行える。
# ADMIN_EMAILS=you@example.com

# リダイレクト URI を明示したい場合のアプリのベース URL（任意・未設定ならリクエストから自動解決）。
# APP_BASE_URL=https://example.com

# プロジェクトごとの DB ファイルを置く基点（任意・既定 data）。data/{projectId}/travel.db に分離される。
# TRAVEL_DATA_DIR=data

# --- 開発専用ログインバイパス（Google 資格情報なしでログインを試すとき） ---
# NODE_ENV=production 以外かつ DEV_LOGIN_SUB 設定時のみ /auth/dev-login が有効になる。
# ロールの既定は admin（管理ダッシュボードもオフラインで確認できるようにするため）。
# 一般ユーザーとして試すときは DEV_LOGIN_ROLE=user を設定する。
# DEV_LOGIN_SUB=dev-user-1
# DEV_LOGIN_EMAIL=dev@example.com
# DEV_LOGIN_NAME=開発ユーザー
# DEV_LOGIN_ROLE=admin


# Gemini の共有 API キー。https://aistudio.google.com/apikey で取得。
# BYOK 未登録ユーザーのフォールバックとして使う（下記の月次上限つき）。
# 全ユーザーが自分のキー(BYOK)を登録する運用なら未設定でも可。
GEMINI_API_KEY=

# 使用モデル（任意・既定 gemini-3-flash-preview）。複雑な調べ物は gemini-3-pro-preview。
# GEMINI_MODEL=gemini-3-flash-preview

# ============================================================
#  BYOK（ユーザー自身の Gemini API キー）と共有キーの月次上限（#93）
# ============================================================
# 各ユーザーは自分の Gemini API キーを画面から登録できる（登録者は上限なし・料金は本人負担）。
# 未登録ユーザーは上の共有キー(GEMINI_API_KEY)にフォールバックし、次の月次上限が適用される。
#
# 共有キー利用時の月次コスト上限（USD・既定 0.5）。超過すると AI 機能を利用不可にし、
# BYOK 登録を促す。ユーザーごとの上書きは Firestore users の sharedKeyMonthlyLimitUsd を
# 直接編集する（allowed と同様、初期は GCP コンソール / gcloud で設定）。
# SHARED_KEY_MONTHLY_LIMIT_USD=0.5
#
# キー本体の保管バックエンド（DB/Firestore に平文で置かない）。
#   secret-manager … GCP Secret Manager（本番の既定）。ユーザーごとに 1 シークレットを作る。
#                     Cloud Run の実行 SA に Secret Manager 管理権限
#                     （roles/secretmanager.admin など、作成/バージョン追加/参照/削除）が必要。
#   local           … AES-256-GCM で暗号化したファイル(data/byok/*.enc)。ローカル開発用。
# 未指定なら FIRESTORE_EMULATOR_HOST があれば local、無ければ secret-manager を自動選択する。
# BYOK_KEY_BACKEND=secret-manager
#
# Secret Manager のシークレット ID 接頭辞（任意・既定 byok-gemini）。
# BYOK_SECRET_PREFIX=byok-gemini
#
# local バックエンドのファイル暗号鍵（local 利用時は必須推奨・未設定だと開発用の既定鍵で警告）。
#   例: openssl rand -hex 32
# BYOK_ENCRYPTION_KEY=

# web_search が使う websearchapi.ai の API キー（必須）。
# https://websearchapi.ai で取得。未設定だと web_search ツールはエラーになる。
WEBSEARCH_API_KEY=

# スポットの Google 評価（★）・写真を取得するための API キー（任意）。
# Google Cloud で「Places API (New)」を有効化し、課金アカウントを登録して取得する。
# 取得結果はスポットごとに DB（spot_place_cache）へキャッシュし、30日でリフレッシュする
# ため、通常は 1 スポットにつき 30日に 1 回しか API を呼ばない（コスト最適化）。
# 評価=Text Search/Place Details Enterprise（月1000件無料）、写真=Place Photo（写真1枚=1課金・
# 月1000件無料）。口コミ本文は取得しない。未設定でもキャッシュがあれば★・写真は表示される。
GOOGLE_MAPS_API_KEY=
