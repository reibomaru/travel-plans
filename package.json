{
  "name": "shiori",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "description": "スイス & 南仏ハネムーン しおり（SQLite永続化・旅程・予算・地図・PDF）",
  "scripts": {
    "dev": "docker compose up -d firestore-emulator && (trap 'docker compose stop firestore-emulator' EXIT INT TERM; concurrently -k -n api,web -c cyan,green \"node --env-file-if-exists=.env server/index.ts\" \"vite\")",
    "dev:no-emu": "concurrently -k -n api,web -c cyan,green \"node --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "emulator": "docker compose up firestore-emulator",
    "emulator:logs": "docker compose logs -f firestore-emulator",
    "web": "vite",
    "api": "node --env-file-if-exists=.env server/index.ts",
    "db:init": "node db/seed.ts",
    "db:reset": "node db/seed.ts --reset",
    "test": "docker compose up -d firestore-emulator && FIRESTORE_EMULATOR_HOST=localhost:8085 FIRESTORE_PROJECT_ID=demo node --test \"server/**/*.test.ts\"",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.5",
    "@deck.gl/geo-layers": "^9.3.5",
    "@deck.gl/layers": "^9.3.5",
    "@deck.gl/react": "^9.3.5",
    "@deck.gl/widgets": "^9.3.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-ai": "^0.80.2",
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@google-cloud/firestore": "^8.7.0",
    "@google-cloud/secret-manager": "^6.3.0",
    "@hono/node-server": "^1.13.7",
    "@hono/oauth-providers": "^0.8.6",
    "heic-convert": "^2.1.0",
    "hono": "^4.6.14",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
